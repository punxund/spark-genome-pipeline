<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 블록 크기 설정 (128MB) -->
    <property>
        <name>dfs.blocksize</name>
        <value>134217728</value>
    </property>
    
    <!-- 복제본 수 -->
    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>
    
    <!-- NameNode 데이터 디렉토리 -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>/opt/hadoop/data/namenode</value>
    </property>
    
    <!-- DataNode 데이터 디렉토리 -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>/opt/hadoop/data/datanode</value>
    </property>
    
    <!-- NameNode HTTP 주소 (컨테이너 내부에서 모든 인터페이스 바인딩) -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
    </property>

    <!-- RPC: 클라이언트/데이터노드는 fs.defaultFS(FQDN:9000)로 접속; 컨테이너 안에서는 0.0.0.0에 바인드 (BindException 방지) -->
    <property>
        <name>dfs.namenode.rpc-address</name>
        <value>hongsik1.vm.informatik.hu-berlin.de:9000</value>
    </property>
    <property>
        <name>dfs.namenode.rpc-bind-host</name>
        <value>0.0.0.0</value>
    </property>
    
    <!-- Secondary NameNode HTTP 주소 (필요 시 변경 가능, 현재는 기본값 사용) -->
    
    <!-- 최소 블록 크기 -->
    <property>
        <name>dfs.namenode.fs-limits.min-block-size</name>
        <value>1048576</value>
    </property>
    
    <!-- 최대 블록 크기 -->
    <property>
        <name>dfs.namenode.fs-limits.max-blocks-per-file</name>
        <value>1048576</value>
    </property>
</configuration>
